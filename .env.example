# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/silly_debates

# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# DigitalOcean Gradient AI (serverless inference)
GRADIENT_API_KEY=
GRADIENT_INFERENCE_URL=https://inference.do-ai.run/v1/chat/completions
GRADIENT_INFERENCE_MODEL=llama3.3-70b-instruct

# Gradient Knowledge Base (optional; chat falls back to database context)
GRADIENT_KB_UUID=
DO_API_TOKEN=

# DigitalOcean Spaces (optional; used to sync debate history to the KB)
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=silly-debates
SPACES_REGION=nyc3

# Email sign-in links (optional). Both must be set to show the email option.
AUTH_RESEND_KEY=
EMAIL_FROM=

# Anonymous voters allowed per debate from one network address (default 10)
ANON_VOTERS_PER_IP=

# Comma-separated emails allowed to open /admin/metrics (empty = nobody)
ADMIN_EMAILS=

# Cron endpoints. Required: /api/cron/* returns 401 when this is unset.
CRON_SECRET=
# Used by the DigitalOcean Functions in functions/ to reach the app
APP_URL=http://localhost:3000
